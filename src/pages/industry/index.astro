---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="产业资讯" slug="industry/" breadcrumb={[{label:'产业资讯'}]}>
  <div class="page-title">
    <h1>🏭 产业资讯</h1>
    <p>保定冰柿产业发展、政策解读、标准化建设、数据报告</p>
  </div>

  <!-- Data dashboard -->
  <div class="card">
    <h2>📊 产业数据一览</h2>
    <p style="font-size:0.85rem;color:#888;margin-bottom:12px;">保定市提出「百亿级磨盘柿产业」奋斗目标，打造中国磨盘柿第一市</p>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;">
      <div style="text-align:center;padding:16px 10px;background:#fff7ed;border-radius:8px;">
        <div style="font-size:1.5rem;font-weight:700;color:#c2410c;">5家 → 12家</div>
        <div style="font-size:0.78rem;color:#888;">加工主体（新华网→河北台Q1）</div>
      </div>
      <div style="text-align:center;padding:16px 10px;background:#fff7ed;border-radius:8px;">
        <div style="font-size:1.5rem;font-weight:700;color:#c2410c;">35条</div>
        <div style="font-size:0.78rem;color:#888;">生产线</div>
      </div>
      <div style="text-align:center;padding:16px 10px;background:#fff7ed;border-radius:8px;">
        <div style="font-size:1.5rem;font-weight:700;color:#c2410c;">8750万</div>
        <div style="font-size:0.78rem;color:#888;">年产能（枚）（北京日报）</div>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:8px;">
      <div style="text-align:center;padding:16px 10px;background:#fff7ed;border-radius:8px;">
        <div style="font-size:1.2rem;font-weight:700;color:#c2410c;">626.3万枚</div>
        <div style="font-size:0.78rem;color:#888;">Q1 2026 产量（+96%）</div>
      </div>
      <div style="text-align:center;padding:16px 10px;background:#fff7ed;border-radius:8px;">
        <div style="font-size:1.2rem;font-weight:700;color:#c2410c;">545万枚</div>
        <div style="font-size:0.78rem;color:#888;">Q1 2026 销量（+70%）</div>
      </div>
      <div style="text-align:center;padding:16px 10px;background:#fff7ed;border-radius:8px;">
        <div style="font-size:1.5rem;font-weight:700;color:#c2410c;">5亿元</div>
        <div style="font-size:0.78rem;color:#888;">磨盘柿综合产值</div>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:8px;">
      <div style="text-align:center;padding:16px 10px;background:#fff7ed;border-radius:8px;">
        <div style="font-size:1.2rem;font-weight:700;color:#c2410c;">30万亩</div>
        <div style="font-size:0.78rem;color:#888;">保定柿子种植面积</div>
      </div>
      <div style="text-align:center;padding:16px 10px;background:#fff7ed;border-radius:8px;">
        <div style="font-size:1.2rem;font-weight:700;color:#c2410c;">50万吨</div>
        <div style="font-size:0.78rem;color:#888;">年产量（占全国12%）</div>
      </div>
      <div style="text-align:center;padding:16px 10px;background:#fff7ed;border-radius:8px;">
        <div style="font-size:1rem;font-weight:700;color:#c2410c;">≈10-20元/枚</div>
        <div style="font-size:0.78rem;color:#888;">冰柿零售价</div>
      </div>
    </div>
  </div>

  <!-- Enterprise registry timeline -->
  <div class="card">
    <h2>🏢 企业创建时间</h2>
    <p style="font-size:0.85rem;color:#888;margin-bottom:12px;">收录的冰柿产业相关企业注册成立时间</p>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;">
      <div style="text-align:center;padding:14px 8px;background:#f0fdf4;border-radius:8px;border:1px solid #bbf7d0;">
        <div style="font-size:0.85rem;font-weight:700;color:#16a34a;">2016-03</div>
        <div style="font-size:0.82rem;margin-top:2px;">柿柿如意</div>
        <div style="font-size:0.7rem;color:#888;">王永旺 · 冰柿开创者</div>
      </div>
      <div style="text-align:center;padding:14px 8px;background:#f0fdf4;border-radius:8px;border:1px solid #bbf7d0;">
        <div style="font-size:0.85rem;font-weight:700;color:#16a34a;">2017-03</div>
        <div style="font-size:0.82rem;margin-top:2px;">银虹农业</div>
        <div style="font-size:0.7rem;color:#888;">品牌「秋色围城」</div>
      </div>
      <div style="text-align:center;padding:14px 8px;background:#f0fdf4;border-radius:8px;border:1px solid #bbf7d0;">
        <div style="font-size:0.85rem;font-weight:700;color:#16a34a;">2019-07</div>
        <div style="font-size:0.82rem;margin-top:2px;">世际德力</div>
        <div style="font-size:0.7rem;color:#888;">高新技术企业</div>
      </div>
      <div style="text-align:center;padding:14px 8px;background:#f0fdf4;border-radius:8px;border:1px solid #bbf7d0;">
        <div style="font-size:0.85rem;font-weight:700;color:#16a34a;">2020-04</div>
        <div style="font-size:0.82rem;margin-top:2px;">沃隆农业</div>
        <div style="font-size:0.7rem;color:#888;">品牌「独乐时光」</div>
      </div>
      <div style="text-align:center;padding:14px 8px;background:#f0fdf4;border-radius:8px;border:1px solid #bbf7d0;">
        <div style="font-size:0.85rem;font-weight:700;color:#16a34a;">2025-06</div>
        <div style="font-size:0.82rem;margin-top:2px;">金柿缘</div>
        <div style="font-size:0.7rem;color:#888;">品牌「零柿界」</div>
      </div>
      <div style="text-align:center;padding:14px 8px;background:#f0fdf4;border-radius:8px;border:1px solid #bbf7d0;">
        <div style="font-size:0.85rem;font-weight:700;color:#16a34a;">2025-08</div>
        <div style="font-size:0.82rem;margin-top:2px;">国强农业</div>
        <div style="font-size:0.7rem;color:#888;">品牌「柿小意」</div>
      </div>
      <div style="text-align:center;padding:14px 8px;background:#f0fdf4;border-radius:8px;border:1px solid #bbf7d0;">
        <div style="font-size:0.85rem;font-weight:700;color:#16a34a;">2025-08</div>
        <div style="font-size:0.82rem;margin-top:2px;">柿界新宠</div>
        <div style="font-size:0.7rem;color:#888;">满城柿子沟</div>
      </div>
      <div style="text-align:center;padding:14px 8px;background:#f0fdf4;border-radius:8px;border:1px solid #bbf7d0;">
        <div style="font-size:0.85rem;font-weight:700;color:#16a34a;">2025-08</div>
        <div style="font-size:0.82rem;margin-top:2px;">盘柿源联合社</div>
        <div style="font-size:0.7rem;color:#888;">11村联合</div>
      </div>
      <div style="text-align:center;padding:14px 8px;background:#f0fdf4;border-radius:8px;border:1px solid #bbf7d0;">
        <div style="font-size:0.85rem;font-weight:700;color:#16a34a;">2025-12</div>
        <div style="font-size:0.82rem;margin-top:2px;">柿冰冰</div>
        <div style="font-size:0.7rem;color:#888;">国潮盲盒</div>
      </div>
    </div>
  </div>

  <!-- Timeline -->
  <div class="card">
    <h2>📅 产业发展时间线</h2>
    <div style="position:relative;padding-left:24px;margin-top:16px;">
      <div style="position:absolute;left:8px;top:0;bottom:0;width:2px;background:#fdba74;"></div>
      {[
        { year: '2014', title: '柿子行情低迷', desc: '柿子价格跌至谷底，出现无人采摘现象。王永旺等带头人成立合作社探索转型。' },
        { year: '2018', title: '沃隆启动研发', desc: '郭子龙与河北大学、河北农业大学、西北农林科技大学等高校合作，耗时5年多研发精准控温工艺。' },
        { year: '2022', title: '冰柿品类诞生', desc: '王永旺受冷冻水果启发首创「杯装冰柿、勺挖食用」模式。沃隆投入10万枚柿子专项研发，推出初级冰柿并创立「独乐时光」品牌。' },
        { year: '2023', title: '冰柿试产成功', desc: '王永旺小批量试产20万个冰柿，产品供不应求。沃隆通过有机食品认证，公开品鉴获好评。' },
        { year: '2024', title: '冰柿走红 · 获评区域公用品牌', desc: '保定冰柿获评保定市区域公用品牌。上海国际果蔬展举办专场推介会，与560余家客商达成意向。投资500万元扶持两家冰柿工厂。沃隆参加亚洲电子商务生态大会、高碑店绿色建筑大会等展会。柿子产业协议签署。' },
        { year: '2025-06-13', title: '保定市冰柿协会成立', desc: '保定市冰柿协会正式成立，首批30家会员单位。会长郭子龙（沃隆农业），副会长王永旺（柿柿如意）、石洪亮（泰宇农业）、冉永亮（马连川村合作社），秘书长李旺（国腾林果）。市农业农村局崔文宇主持。' },
        { year: '2025-09', title: '「秋色围城」获省级科技型中小企业', desc: '保定银虹农业发展有限公司旗下「秋色围城」品牌获评省级科技型中小企业。坚持纯天然零添加理念。' },
        { year: '2025-10', title: '共享产业园投产', desc: '易县190亩冰柿共享产业园正式投产，一期40亩配备共享车间、冷库、电商直播基地，1.34亿专债资金。' },
        { year: '2025-11', title: '「柿界新宠」千年福禄寿柿王开摘', desc: '柿界新宠在满城区神星镇东峪村启动千年「福禄寿」柿子王树采摘仪式，三棵树龄千年以上的国家一级古树果实加工成冰柿。' },
        { year: '2025', title: '产业化加速', desc: '三大龙头企业（沃隆「独乐时光」、柿柿如意「柿妞」、柿界新宠）投产。全年上市约320万个冰柿，产值3200万元。自动去皮机研发成功。光明日报、人民日报、央视网密集报道。' },
        { year: '2025', title: '「独乐时光」牵头成立柿子协会', desc: '沃隆农业牵头成立保定市柿子协会并任会长单位。2026年获评市级重点龙头企业，通过HACCP和质量管理体系认证。拥有6项国家专利。' },
        { year: '2026-01', title: '「柿小意」投产 & 盒马上线', desc: '柿小意3000万元冰柿产业园投建，全年销量突破百万盒，复购率45%。冰柿进驻盒马鲜生（9.9元/杯）、北京物美等高端渠道，签约7个省级代理。' },
        { year: '2026-02', title: '「柿冰冰」国潮盲盒首发', desc: '柿冰冰在爱情广场举办全国首发活动，三重口感（冰沙+流心+蜜浆）+柿子公仔盲盒（6款）+祝福卡，首日预售突破10万杯，小红书曝光超百万。' },
        { year: '2026-03', title: '亮相深圳全食展', desc: '「柿妞」「秋色围城」及世际德力三家企业参展深圳第二十六届全食展。柿妞推迷你冰柿、柿叶面膜。俄罗斯客商点赞。' },
        { year: '2026-04-28', title: '全球发布会 & 出口加拿大', desc: '「保定冰柿·闪亮全球」发布会举行，中国冰柿/磨盘柿产业中心揭牌。企业增至5家、生产线35条。首批15000枚冰柿经天津港发往加拿大。共享产业园投资1.3亿元。盒马上线9.9元/杯。' },
        { year: '2026-05', title: '广交会亮相', desc: '保定冰柿亮相第139届广交会，吸引俄罗斯、澳大利亚、美国、印尼等30多个国家采购商。' },
        { year: '2026-05-25', title: 'Q1产量同比增96%', desc: '河北台报道：一季度生产626.3万枚，销售545万枚，同比增96%、70%。加工主体从2家增至12家。韩国、美国客户洽谈中。' },
      ].reverse().map((item, i) => (
        <div style="position:relative;padding:0 0 18px 16px;">
          <div style="position:absolute;left:-20px;top:4px;width:12px;height:12px;border-radius:50%;background:#c2410c;border:2px solid #fff;box-shadow:0 0 0 2px #c2410c;"></div>
          <div style="font-size:0.78rem;color:#c2410c;font-weight:600;">{item.year}</div>
          <div style="font-weight:600;margin:1px 0 3px;font-size:0.95rem;">{item.title}</div>
          <div style="font-size:0.85rem;color:#666;">{item.desc}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- Policy -->
  <div class="card">
    <div style="display:flex;align-items:center;justify-content:space-between;">
      <h2 style="margin:0;">📋 政策规划</h2>
      <a href="/industry/policies" style="font-size:0.85rem;color:#c2410c;">查看官方文件全文 →</a>
    </div>
    <ul>
      <li><strong>百亿级目标</strong> — 聚焦百亿级磨盘柿产业奋斗目标，打造「中国磨盘柿第一市」</li>
      <li><strong>三年行动计划</strong> — 《保定市柿子产业高质量发展三年行动计划（2024-2026年）》明确「一年打基础、两年上台阶、三年成品牌」</li>
      <li><strong>品牌培育方案</strong> — 《保定冰柿品牌培育推广营销方案》围绕品牌打造、市场营销、包装设计提出具体思路</li>
      <li><strong>团标制定</strong> — 《保定冰柿团体标准》《保定冰柿食品安全标准》等系列标准启动制定</li>
      <li><strong>产业联盟</strong> — 约30家经营主体成立保定市柿子产业高质量发展联盟</li>
      <li><strong>人才支撑</strong> — 选派大学生农业职业经理人601名，解决问题1415个，创单日直播销售破百万</li>
    </ul>
  </div>

  <!-- Infrastructure -->
  <div class="card">
    <h2>🏗️ 产业基础设施</h2>
    <ul>
      <li><strong>冰柿共享产业园</strong> — 易县190亩，一期40亩，配备共享车间、冷库、电商直播基地。项目申请1.34亿专债资金</li>
      <li><strong>绿色标准化示范基地</strong> — 种植端建成4个</li>
      <li><strong>自动去皮机</strong> — 沃隆农业联合研发，一小时500枚（人工120枚/天），发明专利申报中</li>
      <li><strong>智能化生产线</strong> — 单条投资500万元，全流程自动化。2026年初沃隆完成8条线采购投产</li>
      <li><strong>共享检测中心</strong> — 保定海关与易县政府共同设立「保定冰柿共享检测中心」</li>
    </ul>
  </div>

  <!-- Farmers -->
  <div class="card">
    <h2>🌱 联农带农成果</h2>
    <ul>
      <li>鲜柿收购价：从0.3元/斤 → 1-2元/斤，涨幅超300%</li>
      <li>种植户每亩收益：从3500元 → 6600元</li>
      <li>村民就业：吸纳200余人（留守妇女、脱贫户占比超七成），人均年增收超2万元</li>
      <li>易县独乐乡果农每人每年平均增产6000元</li>
      <li>国强农业带动上千户柿农增收，柿小意磨盘柿收购价提升30%</li>
      <li>易县磨盘柿综合产值达5亿元，带动1.2万农户增收（保定晚报）</li>
      <li>销售模式：「龙头企业+合作社+种植户」+保底价收购+二次分红</li>
    </ul>
  </div>

  <!-- Value add -->
  <div class="card">
    <h2>💰 附加值提升</h2>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:12px;">
      <div style="text-align:center;padding:16px;background:#f0fdf4;border-radius:8px;border:1px solid #bbf7d0;">
        <div style="font-size:0.78rem;color:#666;margin-bottom:4px;">鲜柿价格</div>
        <div style="font-size:1.3rem;font-weight:700;color:#16a34a;">几毛/斤</div>
      </div>
      <div style="text-align:center;padding:16px;background:#fff7ed;border-radius:8px;border:1px solid #fdba74;">
        <div style="font-size:0.78rem;color:#666;margin-bottom:4px;">冰柿价格</div>
        <div style="font-size:1.3rem;font-weight:700;color:#c2410c;">≈10-20元/枚</div>
      </div>
    </div>
    <p style="font-size:0.88rem;color:#666;margin-top:12px;text-align:center;">冰柿价格约10-20元/枚，鲜柿收购价约1-2元/斤（人民日报）</p>
  </div>
</BaseLayout>
